<?xml version="1.0"?>
<!--
  voron24_macros.xacro
  ====================
  관성 계산 매크로 + mock 박스 / 실제 메시 전환 매크로.
  이 파일은 C(ROS2 담당)가 관리한다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="MESH_PKG" value="package://voron24_description/meshes"/>
  <!-- 메시는 mm 단위로 저장 (계약 §4). URDF 에서 m 로 축소. -->
  <xacro:property name="MESH_SCALE" value="0.001 0.001 0.001"/>

  <!-- 박스 근사 관성. 3D 프린터는 저속이라 이 정도로 충분하다. -->
  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}"
               iyy="${m*(x*x+z*z)/12.0}"
               izz="${m*(x*x+y*y)/12.0}"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!--
    링크 형상 매크로.
    use_meshes=true  -> meshes/visual/<name>.stl + meshes/collision/<name>.stl
    use_meshes=false -> 박스 (mock)

    A 의 메시가 아직 없어도 use_meshes:=false 로 전체 파이프라인이 돌아간다.
  -->
  <xacro:macro name="link_geometry" params="name use_meshes bx by bz ox:=0 oy:=0 oz:=0 color_name color_rgba">
    <xacro:if value="${use_meshes}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${MESH_PKG}/visual/${name}.stl" scale="${MESH_SCALE}"/>
        </geometry>
        <material name="${color_name}"><color rgba="${color_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${MESH_PKG}/collision/${name}.stl" scale="${MESH_SCALE}"/>
        </geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${use_meshes}">
      <visual>
        <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
        <geometry><box size="${bx} ${by} ${bz}"/></geometry>
        <material name="${color_name}"><color rgba="${color_rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
        <geometry><box size="${bx} ${by} ${bz}"/></geometry>
      </collision>
    </xacro:unless>
  </xacro:macro>

</robot>
