<?xml version="1.0"?>
<!--
  Generated from voron24.urdf.xacro with use_meshes:=false.
  Source: voron24-mock.tar.gz
  Target: Voron 2.4 R2 / 250 mm mock skeleton for Unity URDF Importer.

  Units: metres, radians, kilograms.
  The dimensions marked as estimates in voron24_params.xacro remain estimates.
-->
<robot name="voron24">

  <!-- Fixed frame, enclosure envelope, bed, electronics and Z motors. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.2325" rpy="0 0 0"/>
      <geometry><box size="0.350 0.350 0.465"/></geometry>
      <material name="frame"><color rgba="0.60 0.62 0.65 0.20"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.060" rpy="0 0 0"/>
      <geometry><box size="0.250 0.250 0.008"/></geometry>
      <material name="bed"><color rgba="0.13 0.13 0.16 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2325" rpy="0 0 0"/>
      <geometry><box size="0.350 0.350 0.465"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.1395" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.338725" iyy="0.338725" izz="0.245"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Flying gantry: the whole assembly moves along +Z. -->
  <link name="z_gantry">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.330 0.330 0.030"/></geometry>
      <material name="voron_red"><color rgba="0.85 0.27 0.20 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.330 0.330 0.030"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.2"/>
      <inertia ixx="0.02013" iyy="0.02013" izz="0.03993"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_z" type="prismatic">
    <parent link="base_link"/>
    <child link="z_gantry"/>
    <origin xyz="0.0 0.0 0.2145" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.250" effort="200" velocity="0.05"/>
    <dynamics damping="5.0" friction="2.0"/>
  </joint>

  <!-- X extrusion moves along +Y. -->
  <link name="x_beam">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.320 0.030 0.030"/></geometry>
      <material name="voron_blue"><color rgba="0.20 0.50 0.85 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.320 0.030 0.030"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.000135" iyy="0.0077475" izz="0.0077475"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_y" type="prismatic">
    <parent link="z_gantry"/>
    <child link="x_beam"/>
    <origin xyz="0.0 -0.125 0.012" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.250" effort="50" velocity="0.5"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- Stealthburner/Clockwork2 mock box moves along +X. -->
  <link name="toolhead">
    <visual>
      <origin xyz="0 0.010 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.055 0.060 0.090"/></geometry>
      <material name="toolhead_white"><color rgba="0.92 0.92 0.94 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0.010 -0.030" rpy="0 0 0"/>
      <geometry><box size="0.055 0.060 0.090"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.010 -0.030" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.00043875" iyy="0.0004171875" izz="0.0002484375"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_x" type="prismatic">
    <parent link="x_beam"/>
    <child link="toolhead"/>
    <origin xyz="-0.125 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.250" effort="50" velocity="0.5"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- Tool center point. No visual geometry. -->
  <link name="nozzle"/>
  <joint name="joint_nozzle" type="fixed">
    <parent link="toolhead"/>
    <child link="nozzle"/>
    <origin xyz="0.0 0.0085 -0.0520" rpy="0 0 0"/>
  </joint>

  <!-- G-code origin fixed to the bed; Voron 2.4 is not a bed slinger. -->
  <link name="bed_origin"/>
  <joint name="joint_bed_origin" type="fixed">
    <parent link="base_link"/>
    <child link="bed_origin"/>
    <origin xyz="-0.125 -0.125 0.0640" rpy="0 0 0"/>
  </joint>

</robot>
