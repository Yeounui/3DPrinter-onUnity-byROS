<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="base_link_demo">

  <!-- Project convention: all geometry and joint coordinates use 1 unit = 1 mm. -->
  <xacro:property name="mesh_root" value="file:///home/wjd/Desktop/temporal_AI_workspace/ros2_ws_stl_demo/src/printer_description/meshes"/>

  <xacro:macro name="printer_links">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/base_link.stl" scale="1 1 1"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/base_link.stl" scale="1 1 1"/></geometry>
      </collision>
    </link>

    <link name="z_gantry_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/z_gantry.stl" scale="1 1 1"/></geometry>
        <material name="z_gantry_blue"><color rgba="0.10 0.35 0.95 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/z_gantry.stl" scale="1 1 1"/></geometry>
      </collision>
    </link>

    <link name="x_beam_black_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/x_beam.stl" scale="1 1 1"/></geometry>
        <material name="x_beam_black"><color rgba="0.02 0.02 0.02 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/x_beam.stl" scale="1 1 1"/></geometry>
      </collision>
    </link>

    <link name="toolhead_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/toolhead.stl" scale="1 1 1"/></geometry>
        <material name="toolhead_green"><color rgba="0.08 0.80 0.18 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_root}/toolhead.stl" scale="1 1 1"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="printer_joint" params="joint_name joint_type parent child xyz axis:='0 0 0' lower:='-1000' upper:='1000'">
    <joint name="${joint_name}" type="${joint_type}">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <xacro:if value="${joint_type != 'fixed'}">
        <axis xyz="${axis}"/>
        <limit lower="${lower}" upper="${upper}" effort="1" velocity="1"/>
      </xacro:if>
    </joint>
  </xacro:macro>
</robot>
