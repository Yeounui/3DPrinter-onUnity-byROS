<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voron24_slicer_msgs</name>
  <version>0.1.0</version>
  <description>SliceModel action for the Voron 2.4 slicer (docs/04b section 6)</description>
  <maintainer email="team@example.com">voron24 team</maintainer>
  <license>MIT</license>

  <!-- 왜 voron24_slicer 안이 아니라 별도 패키지인가.
       04b §275 는 "SliceModel.action 은 voron24_slicer 패키지 자체에 정의한다" 인데
       그 문장의 근거로 §276 이 든 것은 "voron24_msgs 에 넣으면 계약 변경(PR + 3 인
       승인)이 된다" 하나뿐이다. 즉 문서가 지키려던 것은 **계약 패키지를 오염시키지
       말 것**이고, 그 의도는 이 패키지로도 그대로 지켜진다 — voron24_msgs 는 손대지
       않았고 계약 §3/§6 도 그대로다.

       한 패키지로 붙이지 않은 이유는 기술적이다. rosidl_generate_interfaces 가
       내부적으로 프로젝트 이름과 같은 이름의 파이썬 패키지와 그 빌드 타깃을 만들기
       때문에, 같은 패키지에서 노드용 파이썬 모듈을 얹으려면 CMake 타깃 이름이
       겹치거나(ament_python_install_package 중복 호출 -> configure 실패) rosidl 이
       깔아 둔 __init__.py 에 install(FILES) 로 얹어 붙이는 우회가 필요하다.
       후자는 지금은 돌지만 rosidl 생성물 배치에 기대는 구성이라 ROS 버전이 올라가면
       조용히 깨진다. 인터페이스 패키지를 떼는 쪽이 ROS2 의 표준 구성이고,
       voron24_msgs(ament_cmake) / voron24_gcode(ament_python) 로 이미 이 레포가 쓰고
       있는 분리와 같은 모양이다. -->

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export><build_type>ament_cmake</build_type></export>
</package>
